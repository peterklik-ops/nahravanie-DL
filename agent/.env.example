# Skopírujte tento súbor ako ".env" a doplňte reálne údaje.
# .env súbor NIKDY nenahrávajte do gitu / verejného repozitára!

NITECH_USERNAME=
NITECH_PASSWORD=
NITECH_LOGIN_URL=https://www.nitech.sk/sk/prihlasenie
NITECH_DELIVERY_NOTES_URL=https://www.nitech.sk/sk/informacia/dodacie-listy

EUROVAT_USERNAME=
EUROVAT_PASSWORD=
EUROVAT_LOGIN_URL=
EUROVAT_DELIVERY_NOTES_URL=

INTERCARS_USERNAME=
INTERCARS_PASSWORD=
INTERCARS_LOGIN_URL=
INTERCARS_DELIVERY_NOTES_URL=
INTERCARS_OFFER_URL=

IC_OFFICE_LOGIN_URL=
IC_OFFICE_USERNAME=
IC_OFFICE_PASSWORD=

DOWNLOAD_DIR=./downloads
HEADLESS=true

# Notifikácie (e-mail cez Gmail SMTP) - ALERT_EMAIL je adresa, kam
# upozornenia chodia, SMTP_USERNAME/SMTP_PASSWORD je odosielací gmail účet.
# SMTP_PASSWORD musí byť "heslo pre aplikácie" (App Password) z Google
# účtu - bežné heslo do Gmailu na SMTP nefunguje. Návod: Google účet ->
# Zabezpečenie -> Overenie v dvoch krokoch (musí byť zapnuté) -> Heslá
# pre aplikácie -> vytvoriť nové, vložiť sem bez medzier.
ALERT_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
