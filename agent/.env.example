# Skopírujte tento súbor ako ".env" a doplňte reálne údaje.
# .env súbor NIKDY nenahrávajte do gitu / verejného repozitára!

NITECH_USERNAME=
NITECH_PASSWORD=
NITECH_LOGIN_URL=https://www.nitech.sk/sk/prihlasenie
NITECH_DELIVERY_NOTES_URL=https://www.nitech.sk/sk/informacia/dodacie-listy

EUROVAT_USERNAME=
EUROVAT_PASSWORD=
EUROVAT_LOGIN_URL=
EUROVAT_DELIVERY_NOTES_URL=

INTERCARS_USERNAME=
INTERCARS_PASSWORD=
INTERCARS_LOGIN_URL=
INTERCARS_DELIVERY_NOTES_URL=
INTERCARS_OFFER_URL=

IC_OFFICE_LOGIN_URL=
IC_OFFICE_USERNAME=
IC_OFFICE_PASSWORD=

# CSV export skladu z IC Office (Sklady -> Tovar -> export) - stiahnite
# ho pred spustením stock_sync.py / main.py na túto cestu.
IC_OFFICE_STOCK_CSV=./downloads/sklad.csv
IC_OFFICE_STOCK_SKU_COLUMN=Kód
IC_OFFICE_STOCK_QUANTITY_COLUMN=Sklad
IC_OFFICE_STOCK_NAME_COLUMN=Názov
IC_OFFICE_STOCK_CSV_DELIMITER=;
IC_OFFICE_STOCK_CSV_ENCODING=utf-8-sig

# Allegro (Sale/Offer REST API) - založte appku na
# https://apps.developer.allegro.pl/, ALLEGRO_REFRESH_TOKEN sa získa
# jednorazovo cez `python allegro_device_login.py` (viď README).
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REFRESH_TOKEN=
ALLEGRO_AUTH_URL=https://allegro.pl/auth/oauth
ALLEGRO_API_URL=https://api.allegro.pl
ALLEGRO_TOKEN_STORE=./allegro_token.json
ALLEGRO_MISSING_ITEMS_REPORT=./downloads/allegro_chybajuci_tovar.csv

DOWNLOAD_DIR=./downloads
HEADLESS=true
ALERT_EMAIL=
